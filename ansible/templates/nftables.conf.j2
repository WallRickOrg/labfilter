#!/usr/sbin/nft -f

# Managed bridge policy: allow transparent forwarding by default and deny the
# fixed controller-resolved test destination set before the final allow.
flush ruleset

table bridge labfilter {
    set blocked_ipv4 {
        type ipv4_addr
        elements = { {{ labfilter_block_ipv4 | join(', ') }} }
    }

    set blocked_ipv6 {
        type ipv6_addr
        elements = { {{ labfilter_block_ipv6 | join(', ') }} }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        ip daddr @blocked_ipv4 counter drop comment "{{ labfilter_block_rule_name }} IPv4"
        ip6 daddr @blocked_ipv6 counter drop comment "{{ labfilter_block_rule_name }} IPv6"
        counter accept comment "Allow remaining transparent bridge traffic"
    }
}
