#!/usr/sbin/nft -f

# Managed bridge policy: allow transparent forwarding by default and deny the
# fixed controller-resolved test destination set before the final allow. This
# file owns only the Labfilter table so Docker's host firewall rules survive.

table bridge labfilter {
    # Management and Tailscale source networks must never be caught by a
    # destination block set. These accepts are intentionally first in forward.
    set always_allowed_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ labfilter_bridge_always_allowed_ipv4 | join(', ') }} }
    }

    set always_allowed_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ labfilter_bridge_always_allowed_ipv6 | join(', ') }} }
    }

    # Permit only the WireGuard client's tunnel port before country-based
    # destination blocks; all other traffic from the client is evaluated below.
    set wireguard_allowed_udp_ports {
        type inet_service
        elements = { {{ labfilter_wireguard_allowed_udp_ports | join(', ') }} }
    }

    set blocked_ipv4 {
        type ipv4_addr
        elements = { {{ labfilter_block_ipv4 | join(', ') }} }
    }

    set blocked_ipv6 {
        type ipv6_addr
        elements = { {{ labfilter_block_ipv6 | join(', ') }} }
    }

    # The hourly Elasticsearch job owns these persistent dynamic elements.
    set geo_blocked_ipv4 {
        type ipv4_addr
    }

    set geo_blocked_ipv6 {
        type ipv6_addr
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        # Log explicitly allowed exceptions before accepting them; the normal
        # path logs after fixed and dynamic destination blocks are evaluated.
        ip saddr @always_allowed_ipv4 jump log_forward
        ip saddr @always_allowed_ipv4 counter accept comment "Allow local and Tailscale IPv4 management"
        ip6 saddr @always_allowed_ipv6 jump log_forward
        ip6 saddr @always_allowed_ipv6 counter accept comment "Allow Tailscale IPv6 management"
        ip saddr {{ labfilter_wireguard_client_ipv4 }} ip protocol icmp jump log_forward
        ip saddr {{ labfilter_wireguard_client_ipv4 }} ip protocol icmp counter accept comment "Allow WireGuard client ICMP traffic"
        ip saddr {{ labfilter_wireguard_client_ipv4 }} udp dport @wireguard_allowed_udp_ports jump log_forward
        ip saddr {{ labfilter_wireguard_client_ipv4 }} udp dport @wireguard_allowed_udp_ports counter accept comment "Allow WireGuard client tunnel traffic"
        ip daddr @blocked_ipv4 jump block_ipv4
        ip6 daddr @blocked_ipv6 jump block_ipv6
        ip daddr @geo_blocked_ipv4 jump block_geo_ipv4
        ip6 daddr @geo_blocked_ipv6 jump block_geo_ipv6
        jump log_forward
        counter accept comment "Allow remaining transparent bridge traffic"
    }

    chain log_forward {
        # Kibana's browser/API port is excluded so the monitoring platform does
        # not recursively log its own UI traffic.
        tcp dport 5601 counter return comment "Exclude Kibana destination traffic"
        tcp sport 5601 counter return comment "Exclude Kibana source traffic"
        # Log accepted packets, then return to the parent chain without blocking.
        limit rate {{ labfilter_allowed_traffic_log_rate }} burst {{ labfilter_allowed_traffic_log_burst }} packets log prefix "LABFILTER_TRAFFIC " counter return comment "Rate-limited allowed bridge traffic"
    }

    chain block_ipv4 {
        # Limit only the log statement; the following drop remains unconditional.
        limit rate 30/second burst 100 packets log prefix "LABFILTER_BLOCKED "
        counter drop comment "{{ labfilter_block_rule_name }} IPv4"
    }

    chain block_ipv6 {
        # Limit only the log statement; the following drop remains unconditional.
        limit rate 30/second burst 100 packets log prefix "LABFILTER_BLOCKED "
        counter drop comment "{{ labfilter_block_rule_name }} IPv6"
    }

    chain block_geo_ipv4 {
        # Dynamic GeoIP blocks use the same bounded logging behavior as fixed blocks.
        limit rate 30/second burst 100 packets log prefix "LABFILTER_BLOCKED "
        counter drop comment "Automated GeoIP destination block IPv4"
    }

    chain block_geo_ipv6 {
        # Keeping address families separate makes nftables type validation explicit.
        limit rate 30/second burst 100 packets log prefix "LABFILTER_BLOCKED "
        counter drop comment "Automated GeoIP destination block IPv6"
    }
}

# Persist the hourly job's learned elements across nftables reloads and reboots.
include "{{ labfilter_geo_block_include_file }}"
