# Reproduces the verified upstream wireless station settings.
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/axi/1001100000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
	option band '5g'
	option htmode 'HT20'
	option cell_density '0'

# This is a station rather than an access point; the SSID and key come only
# from the ignored local environment at render time.
config wifi-iface '{{ labfilter_wifi_station_section }}'
	option device 'radio0'
	option mode 'sta'
	option network '{{ labfilter_wifi_network_name }}'
	option ssid '{{ labfilter_lanwifi_ssid }}'
	option encryption 'psk2'
	option key '{{ labfilter_lanwifi_psk }}'
