{#
  This separate bridge-family table is required because br-lan is a
  transparent L2 path; inet fw4 zone rules do not see these forwarded frames.
  The bare table and flush commands make repeated firewall reloads idempotent.
#}
table bridge openwrt_bridge_filter
flush table bridge openwrt_bridge_filter

table bridge openwrt_bridge_filter {
    set block_cnn_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ openwrt_block_cnn_ipv4 | join(', ') }} }
    }

    set block_cnn_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ openwrt_block_cnn_ipv6 | join(', ') }} }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        # The ISP router already forwards the original frame toward Proxmox.
        # Accept its web service at the bridge hook without DNAT or L3 routing.
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ip daddr {{ openwrt_proxmox_address }} tcp dport {{ openwrt_proxmox_web_port }} counter accept comment "openwrt: Proxmox-Web-Allow"

        # Match physical bridge ingress rather than br-lan, because the bridge
        # hook observes the enslaved ports on a transparent forwarding path.
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ip daddr @block_cnn_ipv4 counter drop comment "openwrt: {{ openwrt_block_rule_name }}"
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ip6 daddr @block_cnn_ipv6 counter drop comment "openwrt: {{ openwrt_block_rule_name }} IPv6"
    }
}
