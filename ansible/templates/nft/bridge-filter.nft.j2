#!/bin/sh
# LuCI's Firewall → Custom Rules page displays this Ansible-managed script.
# A bridge-family hook is required because transparent br-lan forwarding does
# not traverse firewall4's routed inet fw4 Traffic Rules chains.
nft delete table bridge openwrt_bridge_filter 2>/dev/null || true
nft -f - <<'OPENWRT_BRIDGE_FILTER'
table bridge openwrt_bridge_filter {
    set block_cnn_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ openwrt_block_cnn_ipv4 | join(', ') }} }
    }

    set block_cnn_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ openwrt_block_cnn_ipv6 | join(', ') }} }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        # Keep the test service exception static and free of private backend
        # topology; the current accept policy means this does not broaden live behavior.
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } tcp dport 8006 counter accept comment "openwrt: Allow-TCP-8006"

        # Match physical bridge ingress rather than br-lan, because the bridge
        # hook observes the enslaved ports on a transparent forwarding path.
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ip daddr @block_cnn_ipv4 counter drop comment "openwrt: {{ openwrt_block_rule_name }}"
        iifname { {% for interface in openwrt_bridge_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ip6 daddr @block_cnn_ipv6 counter drop comment "openwrt: {{ openwrt_block_rule_name }} IPv6"
    }
}
OPENWRT_BRIDGE_FILTER
