# Copy this file to .env on the Docker server. These values reserve Pi-hole's
# intended address on the existing lab LAN; verify the parent interface before
# starting the stack. Do not commit the resulting .env.
PIHOLE_LAN_PARENT=ens18
PIHOLE_LAN_SUBNET=192.168.2.0/24
PIHOLE_LAN_GATEWAY=192.168.2.1
PIHOLE_LAN_IP=192.168.2.7
PIHOLE_NETWORK_NAME=labfilter-pihole-lan
PIHOLE_TZ=Etc/UTC
PIHOLE_UPSTREAM_DNS=1.1.1.1;8.8.8.8
