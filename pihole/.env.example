# Copy this file to .env on the Docker server and fill in the reserved LAN
# values. Do not commit the resulting .env.
PIHOLE_LAN_IP=
PIHOLE_NETWORK_NAME=
PIHOLE_TZ=Etc/UTC
PIHOLE_UPSTREAM_DNS='1.1.1.1;8.8.8.8'
# Base64-encode the Pi-hole web password; do not store it in Git.
PIHOLE_WEBPASSWORD_BASE64=
