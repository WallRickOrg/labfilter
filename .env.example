# The OpenWrt SSH host or address; use a documentation address in this sample.
OPENWRT_HOST=192.0.2.1

# The SSH account used by Ansible; root is typical for OpenWrt administration.
OPENWRT_SSH_USER=root

# Local management values stay in the ignored .env because they are machine-specific.
OPENWRT_MANAGEMENT_ADDRESS=192.0.2.1
OPENWRT_MANAGEMENT_INTERFACE=eth0

# Host-specific non-secret values used by the reproduced UCI templates.
OPENWRT_DEVICE_HOSTNAME=openwrt
OPENWRT_ULA_PREFIX=fd00:1234:5678::/48
OPENWRT_WAN_IP=192.0.2.2
OPENWRT_MANAGEMENT_CIDR=192.0.2.0/24
OPENWRT_UPSTREAM_CIDR=198.51.100.0/24
OPENWRT_UPSTREAM_ADDRESS=198.51.100.2
OPENWRT_LANWIFI_SSID=example-wifi

# Base64-encoded OpenSSH private-key contents; keep the real value only in .env.
OPENWRT_PRIVATE_KEY_BASE64=BASE64_ENCODED_OPENSSH_PRIVATE_KEY

# Base64-encoded values for the wireless PSK and rpcd password hash.
OPENWRT_LANWIFI_PSK_BASE64=BASE64_ENCODED_WIFI_PSK
OPENWRT_RPCD_PASSWORD_BASE64=BASE64_ENCODED_RPCD_PASSWORD_HASH

# Physical bridge members remain local topology even though the fixed CNN test
# hostnames and their runtime DNS resolution are tracked in Ansible.
OPENWRT_BRIDGE_INTERFACES=eth1,eth2

# Policy inputs required before implementing the architecture's firewall intent.
OPENWRT_MANAGEMENT_ALLOWED_SOURCE_CIDR=192.0.2.0/24
OPENWRT_GATEWAY_ADDRESS=192.0.2.1
OPENWRT_DMZ_CIDR=198.51.100.0/24
OPENWRT_DMZ_ALLOWED_TCP_PORTS=21,80,443
OPENWRT_SSH_PORT=21
