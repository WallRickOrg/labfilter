# Connection settings for the Labfilter management path. Use non-personal
# documentation values here; keep the actual values only in ignored `.env`.
LABFILTER_HOST=192.0.2.10
LABFILTER_SSH_USER=labfilter
LABFILTER_SSH_PORT=22
LABFILTER_PRIVATE_KEY_BASE64=BASE64_ENCODED_OPENSSH_PRIVATE_KEY

# The guarded apply verifies this address is present on this wired interface.
LABFILTER_MANAGEMENT_ADDRESS=192.0.2.10
LABFILTER_MANAGEMENT_INTERFACE=eth2

# NetworkManager Wi-Fi station settings. Base64-encode the actual PSK only.
LABFILTER_WIFI_INTERFACE=wlan0
LABFILTER_WIFI_SSID=example-wifi
LABFILTER_WIFI_PSK_BASE64=BASE64_ENCODED_WIFI_PSK
