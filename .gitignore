# Keep credentials and machine-specific connection settings out of Git.
.env
.env.*
!.env.example

# Keep generated discovery exports and router backups local because they can contain secrets.
artifacts/
backups/

# Keep local Ansible inventory and variable overrides private.
ansible/inventory/hosts.local.yml
ansible/group_vars/*.local.yml
ansible/host_vars/*.local.yml
ansible/vars/*.local.yml

# NetworkManager keyfiles can contain Wi-Fi credentials; keep local variants
# and copied connection profiles out of Git.
ansible/templates/**/*.local.j2
*.nmconnection

# Keep private keys, temporary logs, and Ansible runtime files out of Git.
.venv/
# Python test imports create bytecode caches that are local build artifacts.
__pycache__/
# Pi-hole deployment values and the Docker-managed web password stay local.
pihole/.env
pihole/secrets/pihole_web_password
*.pem
*.key
*.retry
ansible.log
